// Smart Packing Planner — core data model (Milestone 1)
// See DESIGN.md for full behavioral spec (snapshot semantics, recursive
// child expansion, single-owner scoping, etc).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth fields (id/name/email/emailVerified/image/username/displayUsername/
// createdAt/updatedAt/sessions/accounts) are Better Auth's — this schema
// shape is generated by `better-auth generate` and hand-merged with our
// app-specific fields (isAdmin, isActive) and ownership relations below.
// Credentials live in Account.password (per-provider), not on User itself.
model User {
  id              String   @id
  name            String
  email           String   @unique
  emailVerified   Boolean  @default(false)
  image           String?
  username        String?  @unique
  displayUsername String?
  isAdmin         Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  categories Category[]
  items      Item[]
  modules    Module[]
  trips      Trip[]
  apiKeys    ApiKey[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One row per sign-in method; for us that's always providerId="credential"
// with the Argon2id password hash in `password`. No OAuth in Version 1.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// Email verification / password reset tokens. Unused in Version 1 (no mail
// server, no self-service reset), but part of Better Auth's core schema.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Category {
  id        String @id @default(cuid())
  ownerId   String
  owner     User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int    @default(0)

  items Item[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model Item {
  id              String   @id @default(cuid())
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  defaultQuantity Int      @default(1)
  notes           String?
  active          Boolean  @default(true)

  moduleItems ModuleItem[]
  tripItems   TripItem[]
  // Rows where this item is the parent; link.childItem is the actual child.
  childLinks  ItemParentChild[] @relation("ParentToChildren")
  // Rows where this item is the child; link.parentItem is the actual parent.
  parentLinks ItemParentChild[] @relation("ChildToParents")

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([categoryId])
}

// Parent -> children direction, matching DESIGN.md's CSV `children` column.
model ItemParentChild {
  parentItemId String
  parentItem   Item   @relation("ParentToChildren", fields: [parentItemId], references: [id], onDelete: Cascade)
  childItemId  String
  childItem    Item   @relation("ChildToParents", fields: [childItemId], references: [id], onDelete: Cascade)

  @@id([parentItemId, childItemId])
  @@index([childItemId])
}

model Module {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name    String

  moduleItems ModuleItem[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model ModuleItem {
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([moduleId, itemId])
  @@index([itemId])
}

model Trip {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  destination String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  tripItems TripItem[]
  bags      Bag[]

  @@index([ownerId])
}

// Snapshot of an Item at generation time (FR-014a). Denormalized fields are
// authoritative for display; sourceItemId is a soft reference only.
model TripItem {
  id               String  @id @default(cuid())
  tripId           String
  trip             Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sourceItemId     String?
  sourceItem       Item?   @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)

  name             String
  category         String
  notes            String?
  quantity         Int     @default(1)

  quantityOverride Int?
  packed           Boolean @default(false)
  removed          Boolean @default(false)
  tripNotes        String?

  bagId String?
  bag   Bag?    @relation(fields: [bagId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([sourceItemId])
  @@index([bagId])
}

model Bag {
  id          String  @id @default(cuid())
  tripId      String
  trip        Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name        String
  bagType     String?
  color       String?
  weightLimit Float?

  tripItems TripItem[]

  @@index([tripId])
}

// Bearer tokens for the read/write REST API (src/app/api/v1). Independent of
// Better Auth's session cookies -- a key is a long-lived credential a script
// or external tool presents on every request. Only the SHA-256 hash is
// stored; the raw key is shown once, at creation, and never again.
model ApiKey {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  keyPrefix  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([ownerId])
}
