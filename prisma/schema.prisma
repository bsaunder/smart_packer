// Smart Packing Planner — core data model (Milestone 1)
// See DESIGN.md for full behavioral spec (snapshot semantics, recursive
// child expansion, single-owner scoping, etc).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth fields (id/name/email/emailVerified/image/username/displayUsername/
// createdAt/updatedAt/sessions/accounts) are Better Auth's — this schema
// shape is generated by `better-auth generate` and hand-merged with our
// app-specific fields (isAdmin, isActive) and ownership relations below.
// Credentials live in Account.password (per-provider), not on User itself.
model User {
  id              String   @id
  name            String
  email           String   @unique
  emailVerified   Boolean  @default(false)
  image           String?
  username        String?  @unique
  displayUsername String?
  isAdmin         Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  categories Category[]
  items      Item[]
  modules    Module[]
  trips      Trip[]
  bags       Bag[]
  tasks      Task[]
  apiKeys    ApiKey[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One row per sign-in method; for us that's always providerId="credential"
// with the Argon2id password hash in `password`. No OAuth in Version 1.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// Email verification / password reset tokens. Unused in Version 1 (no mail
// server, no self-service reset), but part of Better Auth's core schema.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Category {
  id        String @id @default(cuid())
  ownerId   String
  owner     User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int    @default(0)

  items Item[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model Item {
  id              String   @id @default(cuid())
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  defaultQuantity Int      @default(1)
  notes           String?
  active          Boolean  @default(true)
  defaultBagId    String?
  defaultBag      Bag?     @relation(fields: [defaultBagId], references: [id], onDelete: SetNull)

  moduleItems ModuleItem[]
  tripItems   TripItem[]
  // Rows where this item is the parent; link.childItem is the actual child.
  childLinks  ItemParentChild[] @relation("ParentToChildren")
  // Rows where this item is the child; link.parentItem is the actual parent.
  parentLinks ItemParentChild[] @relation("ChildToParents")

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([categoryId])
  @@index([defaultBagId])
}

// Parent -> children direction, matching DESIGN.md's CSV `children` column.
model ItemParentChild {
  parentItemId String
  parentItem   Item   @relation("ParentToChildren", fields: [parentItemId], references: [id], onDelete: Cascade)
  childItemId  String
  childItem    Item   @relation("ChildToParents", fields: [childItemId], references: [id], onDelete: Cascade)

  @@id([parentItemId, childItemId])
  @@index([childItemId])
}

model Module {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name    String

  moduleItems ModuleItem[]
  moduleTasks ModuleTask[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model ModuleItem {
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([moduleId, itemId])
  @@index([itemId])
}

model Trip {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  destination String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  tripItems TripItem[]
  tripTasks TripTask[]

  @@index([ownerId])
}

// Snapshot of an Item at generation time (FR-014a). Denormalized fields are
// authoritative for display; sourceItemId is a soft reference only.
model TripItem {
  id           String  @id @default(cuid())
  tripId       String
  trip         Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sourceItemId String?
  sourceItem   Item?   @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)

  name     String
  category String
  notes    String?
  quantity Int     @default(1)

  quantityOverride Int?
  packed           Boolean @default(false)
  removed          Boolean @default(false)
  tripNotes        String?

  bagId String?
  bag   Bag?    @relation(fields: [bagId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([sourceItemId])
  @@index([bagId])
}

// Master data, like Category: one row per physical bag, shared by every
// Trip. Items name a default; TripItem.bagId is the per-trip assignment,
// copied from the Item's default when the Trip Item is created.
model Bag {
  id          String  @id @default(cuid())
  ownerId     String
  owner       User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  bagType     String?
  color       String?
  weightLimit Float?
  active      Boolean @default(true)

  items     Item[]
  tripItems TripItem[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

// Bearer tokens for the read/write REST API (src/app/api/v1). Independent of
// Better Auth's session cookies -- a key is a long-lived credential a script
// or external tool presents on every request. Only the SHA-256 hash is
// stored; the raw key is shown once, at creation, and never again.
model ApiKey {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  keyPrefix  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([ownerId])
}

// Pre-trip / post-trip checklist (1.12). Timing is relative to the Trip:
// `offsetDays` before departure (startDate) or after return (endDate).
enum TaskAnchor {
  DEPARTURE
  RETURN
}

// Master Task, like Item: reusable, reaches a Trip via Modules or directly.
// One level of sub-tasks: a sub-task's parent is always top-level, and a
// sub-task always shares its parent's anchor.
model Task {
  id         String     @id @default(cuid())
  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  notes      String?
  active     Boolean    @default(true)
  anchor     TaskAnchor @default(DEPARTURE)
  // Null only on a sub-task, meaning "same timing as its parent".
  offsetDays Int?
  parentId   String?
  parent     Task?      @relation("TaskChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children   Task[]     @relation("TaskChildren")

  moduleTasks ModuleTask[]
  tripTasks   TripTask[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([parentId])
}

model ModuleTask {
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([moduleId, taskId])
  @@index([taskId])
}

// Snapshot of a Task on one Trip (like TripItem): timing is resolved to a
// concrete offset at creation, so later master edits don't change the Trip.
model TripTask {
  id           String     @id @default(cuid())
  tripId       String
  trip         Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sourceTaskId String?
  sourceTask   Task?      @relation(fields: [sourceTaskId], references: [id], onDelete: SetNull)
  parentId     String?
  parent       TripTask?  @relation("TripTaskChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     TripTask[] @relation("TripTaskChildren")

  name       String
  notes      String?
  anchor     TaskAnchor
  offsetDays Int

  done    Boolean   @default(false)
  doneAt  DateTime?
  removed Boolean   @default(false)

  @@index([tripId])
  @@index([sourceTaskId])
  @@index([parentId])
}
