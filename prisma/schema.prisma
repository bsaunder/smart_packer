// Smart Packing Planner — core data model (Milestone 1)
// See DESIGN.md for full behavioral spec (snapshot semantics, recursive
// child expansion, single-owner scoping, etc).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  categories Category[]
  items      Item[]
  modules    Module[]
  trips      Trip[]
}

model Category {
  id        String @id @default(cuid())
  ownerId   String
  owner     User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int    @default(0)

  items Item[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model Item {
  id              String   @id @default(cuid())
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  defaultQuantity Int      @default(1)
  notes           String?
  active          Boolean  @default(true)

  moduleItems ModuleItem[]
  tripItems   TripItem[]
  // Rows where this item is the parent; link.childItem is the actual child.
  childLinks  ItemParentChild[] @relation("ParentToChildren")
  // Rows where this item is the child; link.parentItem is the actual parent.
  parentLinks ItemParentChild[] @relation("ChildToParents")

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([categoryId])
}

// Parent -> children direction, matching DESIGN.md's CSV `children` column.
model ItemParentChild {
  parentItemId String
  parentItem   Item   @relation("ParentToChildren", fields: [parentItemId], references: [id], onDelete: Cascade)
  childItemId  String
  childItem    Item   @relation("ChildToParents", fields: [childItemId], references: [id], onDelete: Cascade)

  @@id([parentItemId, childItemId])
  @@index([childItemId])
}

model Module {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name    String

  moduleItems ModuleItem[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model ModuleItem {
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([moduleId, itemId])
  @@index([itemId])
}

model Trip {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  destination String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  tripItems TripItem[]
  bags      Bag[]

  @@index([ownerId])
}

// Snapshot of an Item at generation time (FR-014a). Denormalized fields are
// authoritative for display; sourceItemId is a soft reference only.
model TripItem {
  id               String  @id @default(cuid())
  tripId           String
  trip             Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sourceItemId     String?
  sourceItem       Item?   @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)

  name             String
  category         String
  notes            String?
  quantity         Int     @default(1)

  quantityOverride Int?
  packed           Boolean @default(false)
  removed          Boolean @default(false)
  tripNotes        String?

  bagId String?
  bag   Bag?    @relation(fields: [bagId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([sourceItemId])
  @@index([bagId])
}

model Bag {
  id          String  @id @default(cuid())
  tripId      String
  trip        Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name        String
  bagType     String?
  color       String?
  weightLimit Float?

  tripItems TripItem[]

  @@index([tripId])
}
